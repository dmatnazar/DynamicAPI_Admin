{
  "name": "dynamic-api-admin",
  "version": "1.0.0",
  "description": "Desktop admin app for the Dynamic API Generator system",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && electron-builder",
