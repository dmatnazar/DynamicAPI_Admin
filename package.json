{
  "name": "bi-platform-client",
  "version": "1.0.0",
  "description": "BI Platform Client — Kärhananyň maglumat bazalaryny dolandyrmak we analitika dashboard-laryny görkezmek üçin desktop programma. MSSQL bilen işleýär, VPS Gateway arkaly uzakdan sinhronlaşdyrýar.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && electron-builder --win --config.electronDist=node_modules/electron/dist",
    "build:dir": "tsc -p tsconfig.json --noEmit && vite build && electron-builder --dir --win --config.electronDist=node_modules/electron/dist",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:installer": "electron-builder --win --config.electronDist=node_modules/electron/dist"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.4",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/view": "^6.35.0",
    "@uiw/react-codemirror": "^4.23.7",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.0",
    "framer-motion": "^11.3.24",
    "lucide-react": "^0.400.0",
    "mssql": "^11.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.5",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "author": "Matnazar Durdymyradov"
}
